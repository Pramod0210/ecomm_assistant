# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is gitignored — never commit real keys.

# ---------- LLM provider selection ----------
# Picks which block under `llm:` in prod_assistant/config/config.yaml is used.
# One of: google | groq | openai
LLM_PROVIDER=google

# ---------- API keys ----------
# GOOGLE_API_KEY is ALWAYS required — embeddings use Google
# text-embedding-004 regardless of which chat provider is selected.
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key

# Only needed when LLM_PROVIDER=groq — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Only needed when LLM_PROVIDER=openai — https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# ---------- AstraDB vector store ----------
# All three are required and validated at startup.
# Create a Serverless (Vector) database at https://astra.datastax.com
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your-application-token
ASTRA_DB_KEYSPACE=default_keyspace

# ---------- Runtime ----------
# "local" loads this .env file; "production" reads variables from the
# environment only (how the Kubernetes deployment supplies them).
ENV=local

# Optional — override the path to config.yaml.
# Defaults to prod_assistant/config/config.yaml
# CONFIG_PATH=prod_assistant/config/config.yaml
